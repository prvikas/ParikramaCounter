<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParikramaCounter.Views.TemplePage"
             Title="Temples"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Pradhakshina Counter" FontSize="26" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center"/>
            <Label Text="Temples" FontSize="16" TextColor="#94a3b8"
                   HorizontalOptions="Center"/>

            <!-- Active temple card -->
            <Frame BackgroundColor="#1e293b" BorderColor="#8b5cf6" CornerRadius="15" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Active temple" FontSize="13" TextColor="#94a3b8"/>
                    <Label Text="{Binding ActiveTempleSummary}" FontSize="16"
                           TextColor="White" FontAttributes="Bold"/>
                    <Button Text="Clear selection"
                            Command="{Binding ClearSelectionCommand}"
                            IsVisible="{Binding HasActiveTemple}"
                            BackgroundColor="#334155" TextColor="#94a3b8"
                            HeightRequest="36" CornerRadius="8" FontSize="13"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Add new temple -->
            <Frame BackgroundColor="#1e293b" BorderColor="#10b981" CornerRadius="15" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Add temple" FontSize="16" FontAttributes="Bold"
                           TextColor="#10b981"/>
                    <Entry Placeholder="Temple name (required)"
                           PlaceholderColor="#64748b" TextColor="White"
                           BackgroundColor="#0f172a"
                           Text="{Binding NewTempleName}"/>
                    <Entry Placeholder="Location — city / district"
                           PlaceholderColor="#64748b" TextColor="White"
                           BackgroundColor="#0f172a"
                           Text="{Binding NewTempleLocation}"/>
                    <Button Text="Add temple"
                            Command="{Binding AddTempleCommand}"
                            BackgroundColor="#10b981" TextColor="White"
                            HeightRequest="44" CornerRadius="10" FontSize="15"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Temple list -->
            <Frame BackgroundColor="#1e293b" BorderColor="#334155" CornerRadius="15" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Select a temple to activate it" FontSize="16"
                           FontAttributes="Bold" TextColor="#94a3b8"/>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="#8b5cf6"/>

                    <!-- TwoWay binding pushes tap selection back into SelectedTemple setter -->
                    <CollectionView ItemsSource="{Binding Temples}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedTemple, Mode=TwoWay}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#0f172a" BorderColor="#334155"
                                       CornerRadius="10" Padding="12" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="15"
                                                   TextColor="White" FontAttributes="Bold"/>
                                            <Label Text="{Binding Location}" FontSize="12"
                                                   TextColor="#64748b"/>
                                        </VerticalStackLayout>
                                        <Button Text="✕"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteTempleCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="#ef4444"
                                                WidthRequest="36" HeightRequest="36"
                                                Grid.Column="1" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Heading distribution — only shown when a temple is selected and has data -->
            <Frame BackgroundColor="#1e293b" BorderColor="#3b82f6" CornerRadius="15" Padding="16"
                   IsVisible="{Binding HasActiveTemple}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Compass heading distribution" FontSize="16"
                           FontAttributes="Bold" TextColor="#3b82f6"/>
                    <Label Text="Bearings observed across all sessions at this temple."
                           FontSize="12" TextColor="#64748b"/>

                    <CollectionView ItemsSource="{Binding HeadingRows}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="90,*,50" ColumnSpacing="8" Padding="0,3">
                                    <Label Text="{Binding BearingLabel}" FontSize="12"
                                           TextColor="#94a3b8" Grid.Column="0"
                                           VerticalOptions="Center"/>
                                    <ProgressBar Progress="{Binding Bar}"
                                                 ProgressColor="#3b82f6" HeightRequest="8"
                                                 Grid.Column="1" VerticalOptions="Center"/>
                                    <Label Text="{Binding Count}" FontSize="12"
                                           TextColor="#3b82f6" HorizontalOptions="End"
                                           Grid.Column="2" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="No data yet — complete sessions at this temple."
                           FontSize="12" TextColor="#64748b" HorizontalOptions="Center"
                           IsVisible="{Binding HasNoHeadingData}"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
