<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParikramaCounter.Views.TrackingPage"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Parikrama Counter" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

            <!-- Target Setting -->
            <Frame BackgroundColor="#1e293b" BorderColor="#8b5cf6" CornerRadius="15" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Target Parikramas" FontSize="16" HorizontalOptions="Center" TextColor="#94a3b8"/>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                        <Button Text="-" Command="{Binding DecrementTargetCommand}" 
                                BackgroundColor="#6366f1" TextColor="White" 
                                WidthRequest="50" HeightRequest="50" CornerRadius="25" FontSize="24"/>
                        <Label Text="{Binding TargetParikrama}" FontSize="48" TextColor="#8b5cf6" 
                               FontAttributes="Bold" VerticalOptions="Center" WidthRequest="80" HorizontalTextAlignment="Center"/>
                        <Button Text="+" Command="{Binding IncrementTargetCommand}" 
                                BackgroundColor="#6366f1" TextColor="White" 
                                WidthRequest="50" HeightRequest="50" CornerRadius="25" FontSize="24"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Progress Bar -->
            <Frame BackgroundColor="#1e293b" BorderColor="#10b981" CornerRadius="15" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ParikramaCount, StringFormat='Completed: {0}'}" 
                           FontSize="18" TextColor="White" HorizontalOptions="Center"/>
                    <ProgressBar Progress="{Binding ProgressPercentage}" 
                                 ProgressColor="#10b981" 
                                 HeightRequest="15"
                                 BackgroundColor="#334155"/>
                    <Label Text="{Binding RemainingParikramas, StringFormat='Remaining: {0}'}" 
                           FontSize="16" TextColor="#94a3b8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
            <Frame BackgroundColor="#1e293b" BorderColor="#f59e0b" CornerRadius="15" Padding="15">
                <Label Text="{Binding MovementStatus}" 
                   FontSize="18" 
                   HorizontalOptions="Center" 
                   TextColor="#f59e0b" 
                   FontAttributes="Bold"/>
            </Frame>
            <!-- Compass Display -->
            <Frame BackgroundColor="#1e293b" BorderColor="#3b82f6" CornerRadius="20" Padding="30">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Heading}" FontSize="48" HorizontalOptions="Center" TextColor="#3b82f6" FontAttributes="Bold"/>
                    <Label Text="{Binding Direction}" FontSize="32" HorizontalOptions="Center" TextColor="White"/>
                    
                </VerticalStackLayout>
            </Frame>
            <!-- Current Circle Progress -->
            <Frame BackgroundColor="#1e293b" BorderColor="#8b5cf6" CornerRadius="15" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Current Parikrama" FontSize="18" HorizontalOptions="Center" TextColor="#94a3b8"/>
                    <Label Text="{Binding CircleDirection}" FontSize="16" HorizontalOptions="Center" TextColor="#8b5cf6"/>
                    <ProgressBar Progress="{Binding CircleProgress}" 
                     ProgressColor="#8b5cf6" 
                     HeightRequest="12"
                     BackgroundColor="#334155"/>
                    <Label Text="{Binding CircleProgress, StringFormat='{0:F1}% Complete'}" 
               FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center"/>
                    <Label Text="{Binding StepsInCircle, StringFormat='Steps: {0}'}" 
               FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Step Counter -->
            <Frame BackgroundColor="#1e293b" BorderColor="#3b82f6" CornerRadius="20" Padding="30">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Steps" FontSize="18" HorizontalOptions="Center" TextColor="#94a3b8"/>
                    <Label Text="{Binding Steps}" FontSize="56" HorizontalOptions="Center" TextColor="#3b82f6" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Target Reached Celebration -->
            <Frame IsVisible="{Binding TargetReached}" 
                   BackgroundColor="#10b981" 
                   BorderColor="#059669" 
                   CornerRadius="15" 
                   Padding="20">
                <Label Text="🎉 Target Completed! 🎉" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center"/>
            </Frame>

            <!-- Controls -->
            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Button Text="{Binding StartStopButtonText}" 
                        Command="{Binding StartStopCommand}"
                        BackgroundColor="#3b82f6" 
                        TextColor="White"
                        WidthRequest="150"
                        HeightRequest="50"
                        CornerRadius="10"
                        FontSize="18"
                        FontAttributes="Bold"/>

                <Button Text="Reset" 
                        Command="{Binding ResetCommand}"
                        BackgroundColor="#ef4444" 
                        TextColor="White"
                        WidthRequest="100"
                        HeightRequest="50"
                        CornerRadius="10"
                        FontSize="18"
                        FontAttributes="Bold"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
