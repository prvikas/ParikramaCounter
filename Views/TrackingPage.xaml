<!--
PSEUDOCODE / PLAN (detailed):
1. Identify XAML 'Border' elements that use invalid properties:
   - 'BorderColor' -> not a property on MAUI Border.
   - 'CornerRadius' -> not a property on MAUI Border.
2. Replace unsupported properties with MAUI Border equivalents:
   - Replace 'BorderColor="#xxxxxx"' with 'Stroke="#xxxxxx"'.
   - Replace 'CornerRadius="N"' with 'StrokeShape="RoundRectangle N,N,N,N"'.
   - For previously used 'StrokeShape' usages, keep existing format.
3. Keep other bindings and layout intact to avoid introducing new errors.
4. Do not remove or modify other valid attributes (BackgroundColor, Padding, etc.).
5. Output updated XAML for the same file path.

Now follows the corrected XAML file with Border property fixes.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParikramaCounter.Views.TrackingPage"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Parikrama Counter" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

            <!-- Target Setting -->
            <Border BackgroundColor="#1e293b" Stroke="#8b5cf6" StrokeShape="RoundRectangle 15,15,15,15" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Target Parikramas" FontSize="16" HorizontalOptions="Center" TextColor="#94a3b8"/>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                        <Button Text="-" Command="{Binding DecrementTargetCommand}" 
                                BackgroundColor="#6366f1" TextColor="White" 
                                WidthRequest="50" HeightRequest="50" CornerRadius="25" FontSize="24"/>
                        <Label Text="{Binding TargetParikrama}" FontSize="48" TextColor="#8b5cf6" 
                               FontAttributes="Bold" VerticalOptions="Center" WidthRequest="80" HorizontalTextAlignment="Center"/>
                        <Button Text="+" Command="{Binding IncrementTargetCommand}" 
                                BackgroundColor="#6366f1" TextColor="White" 
                                WidthRequest="50" HeightRequest="50" CornerRadius="25" FontSize="24"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Progress Bar -->
            <Border BackgroundColor="#1e293b" Stroke="#10b981" StrokeShape="RoundRectangle 15,15,15,15" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ParikramaCount, StringFormat='Completed: {0}'}" 
                           FontSize="18" TextColor="White" HorizontalOptions="Center"/>
                    <ProgressBar Progress="{Binding ProgressPercentage}" 
                                 ProgressColor="#10b981" 
                                 HeightRequest="15"
                                 BackgroundColor="#334155"/>
                    <Label Text="{Binding RemainingParikramas, StringFormat='Remaining: {0}'}" 
                           FontSize="16" TextColor="#94a3b8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Current Circle Progress -->
            <Border BackgroundColor="#1e293b" Stroke="#8b5cf6" StrokeShape="RoundRectangle 15,15,15,15" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Current Parikrama" FontSize="18" HorizontalOptions="Center" TextColor="#94a3b8"/>
                    <Label Text="{Binding CircleDirection}" FontSize="16" HorizontalOptions="Center" TextColor="#8b5cf6"/>
                    <ProgressBar Progress="{Binding CircleProgress}" 
                                 ProgressColor="#8b5cf6" 
                                 HeightRequest="12"
                                 BackgroundColor="#334155"/>
                    <Label Text="{Binding CircleProgress, StringFormat='{0:P0}'}" 
                           FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center"/>
                    <Label Text="{Binding DistanceInCircle, StringFormat='Distance: {0:F1}m'}" 
                           FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Compass Display -->
            <Border BackgroundColor="#1e293b" Stroke="#3b82f6" StrokeShape="RoundRectangle 20,20,20,20" Padding="30">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Heading}" FontSize="48" HorizontalOptions="Center" TextColor="#3b82f6" FontAttributes="Bold"/>
                    <Label Text="{Binding Direction}" FontSize="32" HorizontalOptions="Center" TextColor="White"/>
                    <Label Text="{Binding Accuracy, StringFormat='Accuracy: {0}'}" FontSize="14" HorizontalOptions="Center" TextColor="#94a3b8"/>
                </VerticalStackLayout>
            </Border>

            <!-- Distance & Speed -->
            <Border BackgroundColor="#1e293b" Stroke="#3b82f6" StrokeShape="RoundRectangle 20,20,20,20" Padding="30">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Total Distance" FontSize="18" HorizontalOptions="Center" TextColor="#94a3b8"/>
                    <Label Text="{Binding Distance, StringFormat='{0:F1} m'}" FontSize="56" HorizontalOptions="Center" TextColor="#3b82f6" FontAttributes="Bold"/>
                    <Label Text="{Binding Steps, StringFormat='Steps: {0}'}" FontSize="16" HorizontalOptions="Center" TextColor="#94a3b8"/>
                </VerticalStackLayout>
            </Border>

            <!-- Movement Status & Speed -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border BackgroundColor="#1e293b" Stroke="#f59e0b" StrokeShape="RoundRectangle 15,15,15,15" Padding="15" HorizontalOptions="Fill">
                    <Label Text="{Binding MovementStatus}" 
                           FontSize="18" 
                           HorizontalOptions="Center" 
                           TextColor="#f59e0b" 
                           FontAttributes="Bold"/>
                </Border>

                <Border BackgroundColor="#1e293b" Stroke="#10b981" StrokeShape="RoundRectangle 15,15,15,15" Padding="15" HorizontalOptions="Fill">
                    <Label Text="{Binding CurrentSpeed, StringFormat='{0:F1} km/h'}" 
                           FontSize="18" 
                           HorizontalOptions="Center" 
                           TextColor="#10b981" 
                           FontAttributes="Bold"/>
                </Border>
            </HorizontalStackLayout>

            <!-- Target Reached Celebration -->
            <Border IsVisible="{Binding TargetReached}" 
                   BackgroundColor="#10b981" 
                   Stroke="#059669"
                   StrokeShape="RoundRectangle 15,15,15,15"
                   Padding="20">
                <Label Text="🎉 Target Completed! 🎉" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center"/>
            </Border>

            <!-- Controls -->
            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Button Text="{Binding StartStopButtonText}" 
                        Command="{Binding StartStopCommand}"
                        BackgroundColor="#3b82f6" 
                        TextColor="White"
                        WidthRequest="150"
                        HeightRequest="50"
                        CornerRadius="10"
                        FontSize="18"
                        FontAttributes="Bold"/>

                <Button Text="Reset" 
                        Command="{Binding ResetCommand}"
                        BackgroundColor="#ef4444" 
                        TextColor="White"
                        WidthRequest="100"
                        HeightRequest="50"
                        CornerRadius="10"
                        FontSize="18"
                        FontAttributes="Bold"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
    