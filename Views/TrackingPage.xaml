<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParikramaCounter.Views.TrackingPage"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <Label Text="Pradhakshina Counter" FontSize="26" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center"/>

            <!-- Main counter display -->
            <Frame BackgroundColor="#1e293b" BorderColor="#8b5cf6" CornerRadius="20" Padding="24">
                <VerticalStackLayout Spacing="8">

                    <Label Text="{Binding CountModeLabel}" FontSize="13"
                           TextColor="#94a3b8" HorizontalOptions="Center"/>

                    <!-- Large pradhakshina count -->
                    <Label Text="{Binding DisplayCount}" FontSize="80" FontAttributes="Bold"
                           TextColor="#8b5cf6" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="{Binding TargetParikrama, StringFormat='of {0}'}"
                           FontSize="16" TextColor="#64748b" HorizontalOptions="Center"/>

                    <!-- Manual +/- buttons -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="24" Margin="0,8,0,0">
                        <Button Text="−" Command="{Binding ManualDecrementCommand}"
                                BackgroundColor="#334155" TextColor="#94a3b8"
                                WidthRequest="64" HeightRequest="64" CornerRadius="32" FontSize="30"/>
                        <Label Text="Manual" FontSize="13" TextColor="#64748b"
                               VerticalOptions="Center"/>
                        <Button Text="+" Command="{Binding ManualIncrementCommand}"
                                BackgroundColor="#8b5cf6" TextColor="White"
                                WidthRequest="64" HeightRequest="64" CornerRadius="32" FontSize="30"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Target selection -->
            <Frame BackgroundColor="#1e293b" BorderColor="#6366f1" CornerRadius="15" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Target pradhakshinas" FontSize="13"
                           TextColor="#94a3b8" HorizontalOptions="Center"/>

                    <!-- Preset picker bound to PresetTargets — single source of truth -->
                    <Picker x:Name="PresetPicker"
                            Title="Choose preset"
                            SelectedIndex="{Binding SelectedPresetIndex}"
                            ItemsSource="{Binding PresetTargets}"
                            TextColor="White"
                            TitleColor="#64748b"
                            BackgroundColor="#0f172a"/>

                    <!-- Custom target entry -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="CustomTargetEntry"
                               Placeholder="Custom number"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a"
                               Keyboard="Numeric"
                               ReturnType="Done"
                               Grid.Column="0"
                               ReturnCommand="{Binding SetCustomTargetCommand}"
                               ReturnCommandParameter="{Binding Text, Source={x:Reference CustomTargetEntry}}"/>
                        <Button Text="Set"
                                Clicked="OnSetCustomTargetClicked"
                                BackgroundColor="#6366f1" TextColor="White"
                                WidthRequest="60" HeightRequest="44" CornerRadius="10"
                                Grid.Column="1"/>
                    </Grid>

                    <Label Text="{Binding TargetParikrama, StringFormat='Current target: {0}'}"
                           FontSize="13" TextColor="#6366f1" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Progress -->
            <Frame BackgroundColor="#1e293b" BorderColor="#10b981" CornerRadius="15" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding RemainingParikramas, StringFormat='Remaining: {0}'}"
                           FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center"/>
                    <ProgressBar Progress="{Binding ProgressPercentage}"
                                 ProgressColor="#10b981" HeightRequest="12"
                                 BackgroundColor="#334155"/>
                    <Label Text="{Binding ParikramaCount, StringFormat='Completed: {0}'}"
                           FontSize="14" TextColor="#10b981" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Movement & compass -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Frame BackgroundColor="#1e293b" BorderColor="#f59e0b" CornerRadius="12" Padding="12"
                       Grid.Column="0">
                    <Label Text="{Binding MovementStatus}" FontSize="14"
                           TextColor="#f59e0b" HorizontalOptions="Center" FontAttributes="Bold"/>
                </Frame>
                <Frame BackgroundColor="#1e293b" BorderColor="#3b82f6" CornerRadius="12" Padding="12"
                       Grid.Column="1">
                    <VerticalStackLayout>
                        <Label Text="{Binding Heading}" FontSize="22" FontAttributes="Bold"
                               TextColor="#3b82f6" HorizontalOptions="Center"/>
                        <Label Text="{Binding Direction}" FontSize="14"
                               TextColor="#94a3b8" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Current pradhakshina progress -->
            <Frame BackgroundColor="#1e293b" BorderColor="#6366f1" CornerRadius="15" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Current pradhakshina" FontSize="14"
                               TextColor="#94a3b8" Grid.Column="0"/>
                        <Label Text="{Binding SidesInfo}" FontSize="13"
                               TextColor="#6366f1" Grid.Column="1"/>
                    </Grid>
                    <Label Text="{Binding CircleDirection}" FontSize="13"
                           TextColor="#8b5cf6" HorizontalOptions="Center"/>
                    <ProgressBar Progress="{Binding CircleProgress}"
                                 ProgressColor="#6366f1" HeightRequest="10"
                                 BackgroundColor="#334155"/>
                    <Grid ColumnDefinitions="*,*">
                        <Label Text="{Binding CircleProgress, StringFormat='{0:F0}%'}"
                               FontSize="12" TextColor="#64748b" Grid.Column="0"/>
                        <Label Text="{Binding StepsInCircle, StringFormat='Steps: {0}'}"
                               FontSize="12" TextColor="#64748b" HorizontalOptions="End"
                               Grid.Column="1"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Total steps -->
            <Frame BackgroundColor="#1e293b" BorderColor="#334155" CornerRadius="12" Padding="12">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Label Text="Total steps:" FontSize="14" TextColor="#64748b" VerticalOptions="Center"/>
                    <Label Text="{Binding Steps}" FontSize="22" FontAttributes="Bold"
                           TextColor="#3b82f6" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Target reached banner -->
            <Frame IsVisible="{Binding TargetReached}"
                   BackgroundColor="#10b981" BorderColor="#059669"
                   CornerRadius="15" Padding="20">
                <Label Text="🎉 Target Complete!" FontSize="22" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center"/>
            </Frame>

            <!-- Controls row -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Button Text="{Binding StartStopText}"
                        Command="{Binding StartStopCommand}"
                        BackgroundColor="#3b82f6" TextColor="White"
                        HeightRequest="50" CornerRadius="12"
                        FontSize="17" FontAttributes="Bold" Grid.Column="0"/>

                <Button Text="↕" Command="{Binding ToggleCountModeCommand}"
                        BackgroundColor="#334155" TextColor="#94a3b8"
                        WidthRequest="50" HeightRequest="50" CornerRadius="12"
                        FontSize="20" Grid.Column="1"/>

                <Button Text="Reset" Command="{Binding ResetCommand}"
                        BackgroundColor="#ef4444" TextColor="White"
                        WidthRequest="80" HeightRequest="50" CornerRadius="12"
                        FontSize="15" Grid.Column="2"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
