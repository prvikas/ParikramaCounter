<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Fix #9: single NSMotionUsageDescription — duplicate key was silently
         discarding the pedometer description. One key covers both motion and pedometer. -->
    <key>NSMotionUsageDescription</key>
    <string>ParikramaCounter needs motion and step sensors to count circumambulations and detect walking direction.</string>

    <!-- Fix #10: removed NSLocationAlwaysUsageDescription — app only requests
         LocationWhenInUse so Always description is unused and risks App Store rejection. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Your location helps improve compass accuracy during outdoor Parikrama.</string>

    <!-- Fix #11: removed UIBackgroundModes entirely.
         'location' requires continuous GPS (not used) and 'processing' requires a
         registered BGProcessingTask (not implemented). Both cause App Store rejection
         when declared without matching implementation. -->

</dict>
</plist>
